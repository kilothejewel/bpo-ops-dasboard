# -----------------------------------------------------------------------------
# BPO Ops Dashboard — environment variables
# Copy to the right place and fill in real values. NEVER commit the copy.
#   Dashboard (Next.js):   cp .env.example dashboard/.env.local
#   Python + dbt:          set -a; source .env; set +a   (after cp .env.example .env)
# Every value below has a dev-only default in code, so a local setup with the
# stock postgres/postgres superuser works with no file at all.
# -----------------------------------------------------------------------------

# --- PostgreSQL connection (used by: scripts/generate_data.py, dbt_bpo/profiles.yml, dashboard/lib/db.ts)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bpo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Dashboard session signing (used by: dashboard/lib/session.ts)
# HMAC key for the bpo_session cookie. Required in any shared/deployed
# environment — the fallback is a public placeholder string.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# --- Pipeline status (used by: dashboard/lib/dbt-status.ts)
# Directory containing dbt's run_results.json. Defaults to ../dbt_bpo/target
# relative to the dashboard, which is right for a normal repo checkout.
# DBT_TARGET_DIR=/path/to/dbt_bpo/target

# --- Slack alerts (used by: dashboard/app/api/alerts/notify/route.ts)
# Endpoint stays disabled (503) until ALERTS_CRON_SECRET is set.
# Your scheduler calls:
#   curl -X POST -H "Authorization: Bearer $ALERTS_CRON_SECRET" https://<host>/api/alerts/notify
ALERTS_CRON_SECRET=
# Slack "Incoming Webhook" URL for the target channel. Treat as a secret.
SLACK_WEBHOOK_URL=
# Optional: public dashboard URL, linked from the Slack message.
DASHBOARD_PUBLIC_URL=

# --- Runtime mode (set automatically by Next.js; listed for reference only)
# NODE_ENV=development   # "production" turns on the Secure cookie flag and disables the dev pg pool cache
